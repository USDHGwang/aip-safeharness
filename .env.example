# ── Network selection ──────────────────────────────────────────────────────────
# "testnet" = 0G Galileo (chain 16602)  |  "mainnet" = 0G Aristotle (chain 16661)
NETWORK=testnet

# ── Signing key ───────────────────────────────────────────────────────────────
ZEROG_PRIVATE_KEY=0x<your_private_key_here>

# ── LLM ───────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=<your_gemini_api_key>

# ── Testnet contract addresses (defaults baked into config/network.py) ────────
# Override only if you redeploy:
# AGENT_EXECUTOR_ADDRESS=0xAD561D06c61a11f577b9E89FdEF88AC2eE826ba6
# AIP_ADDRESS_V2=0xB6B4C9cF47D36b8D6B425B4473F9CE81256BE2c7

# ── Mainnet contract addresses (set after Prompt 2 deploy) ───────────────────
# Mainnet has no faucet — acquire OG from listed exchanges before deploy
# (KuCoin / Gate.io / MEXC / LBank -> withdraw to Chain ID 16661)
# AGENT_EXECUTOR_ADDRESS=0x<mainnet_agent_executor>
# AIP_ADDRESS_V2=0x<mainnet_aip_sensory_layer>
